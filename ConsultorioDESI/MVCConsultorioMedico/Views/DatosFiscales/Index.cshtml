@model EntidadesConsultorioMedico.ObjDatosFiscales

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_TemplateAzul.cshtml";
}

<h2>Datos Fiscales</h2>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>

@using (Html.BeginForm("SaveOrUpdateDatosFiscales", "DatosFiscales", FormMethod.Post, new { @id = "frmDatosFiscales", @name = "frmDatosFiscales" }))
{
    @Html.HiddenFor(x => x.Id)
    @Html.HiddenFor(x => x.Estatus)
    @Html.HiddenFor(x => x.CreatedDt)
    @Html.HiddenFor(x => x.CreatedBy)
    @Html.HiddenFor(x => x.UpdatedBy)
    @Html.HiddenFor(x => x.UpdatedDt)

    <div class="row form-group">
        <div class="col-md-4">
            <label>RFC:</label>
            @Html.TextBoxFor(m => m.RFC, new { @class = "form-control" })
        </div>

        <div class="col-md-4">
            <label>Razón Social:</label>
            @Html.TextBoxFor(m => m.RazonSocial, new { @class = "form-control" })
        </div>
        <div class="col-md-4">
            <label>Dirección:</label>
            @Html.TextBoxFor(m => m.Direccion, new { @class = "form-control" })
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-4">
            <label>Email</label>
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
        </div>
        <div class="col-md-4">
            <label>Regimen</label>
            @Html.TextBoxFor(m => m.Regimen, new { @class = "form-control" })
        </div>
        <div class="col-md-4">
            <label>Empresa Id</label>
            @Html.TextBoxFor(m => m.EmpresaId, new { @class = "form-control" })
        </div>
    </div>

    <div class="row form-group">
        <div class="col-md-12">
            <button class="btn btn-success notika-btn-success waves-effect" id="btnGuardar">Guardar</button>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <table id="tblDatos" class="table"></table>    
        </div>    
    </div>
}

<link href="~/Attachment/JqueeyDatatable/jquery.dataTables.min.css" rel="stylesheet" />
<script src="~/Attachment/JqueeyDatatable/jquery.dataTables.min.js"></script>
<script src="~/Scripts/DatosFiscales/DatosFiscales.js"></script>