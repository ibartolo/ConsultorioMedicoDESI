@model MVCConsultorioMedico.Models.ObjTratamientoPaquete

@{
    ViewBag.Title = "IndexTP";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
<h2>IndexTP</h2>

@using (Html.BeginForm("", "", FormMethod.Post, new { @class = "frmTratamientoPaquete", @name = "frmTratamientoPaquete" }))
 {
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.Estatus)
    @Html.HiddenFor(m => m.CreatedBy)
    @Html.HiddenFor(m => m.CreatedDt)
    @Html.HiddenFor(m => m.UpdatedBy)
    @Html.HiddenFor(m => m.UpdatedDt)

    <div class="row form-group">
        <div class="col-md-12">
            <label>Tratamiento</label>
            @Html.DropDownListFor(m => m.TratamientoId, (SelectList)ViewBag.ListaTratamientos, "-- Seleccione un tratamiento --", new { @class = "form-control", @id="list"})
        </div>
        
    </div>
    <div class="row form-group">
        <div class="col-md-4">
            <button id="btnGuardar" type="button" class="btn btn-success notika-btn-success waves-effect">Guardar</button>
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-12">
            <table id="tblTP" class="table"></table>
        </div>
    </div>
 }

<script src="~/Scripts/TratamientoPaquete/Index.js"></script>
<link href="~/Attachment/JqueeyDatatable/jquery.dataTables.min.css" rel="stylesheet" />
<script src="~/Attachment/JqueeyDatatable/jquery.dataTables.min.js"></script>