@model MVCConsultorioMedico.Models.ObjTratamiento

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_TemplateAzul.cshtml";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>

<h2>Tratamientos</h2>

@using (Html.BeginForm("SaveOrUpdateCatalogoTratamiento", "Tratamiento", FormMethod.Post, new { @id = "frmTratamiento", @class = "frmTratamiento" }))
{
    @Html.HiddenFor(x => x.Id)
    @Html.HiddenFor(x => x.CreatedBy)
    @Html.HiddenFor(x => x.CreatedDt)
    @Html.HiddenFor(x => x.UpdatedBy)
    @Html.HiddenFor(x => x.UpdatedDt)
    @Html.HiddenFor(x => x.Estatus)

    <div class="row form-group">
        <div class="col-md-4">
            <label>Nombre</label>
            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
        </div>
        <div class="col-md-4">
            <label>Duración</label>
            @Html.TextBoxFor(m => m.Duracion, new { @class = "form-control" })
        </div>
        <div class="col-md-4">
            <label>Descripción</label>
            @Html.TextBoxFor(m => m.Descripcion, new { @class = "form-control" })
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-4">
            <button class="btn btn-success notika-btn-success waves-effect" id="btnGuardar">Guardar</button>
        </div>
    </div>
    <div class="row form-group">
        <div class="col-md-12">
            <table id="tblTratamiento" class="table"></table>
        </div>
    </div>
}

<script src="~/Scripts/Tratamiento/Index.js"></script>
<link href="~/Attachment/JqueeyDatatable/jquery.dataTables.min.css" rel="stylesheet" />
<script src="~/Attachment/JqueeyDatatable/jquery.dataTables.min.js"></script>