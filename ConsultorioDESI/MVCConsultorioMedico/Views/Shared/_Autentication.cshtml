<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema Centro Médico</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/Content/LoginAzul.css" rel="stylesheet" />
</head>
<body>
    <!-- Página de autenticación (visible por defecto) -->
    <div id="authPage" class="auth-page">
        <div class="auth-container">
            @RenderBody()
        </div>
    </div>

    <!-- Dashboard (oculto inicialmente) -->
    <div id="dashboard" class="hidden">
        <header>
            <button class="menu-toggle">
                <i class="fas fa-bars"></i>
            </button>
            <a href="#" class="logo">
                <i class="fas fa-hospital"></i>
                <span>Centro Médico</span>
            </a>
            <div class="header-actions">
                <button class="notification-btn" id="notificationBtn">
                    <i class="fas fa-bell"></i>
                    <span class="notification-badge">3</span>
                </button>
                <button class="profile-btn">
                    <i class="fas fa-user"></i>
                </button>
                <button class="logout-btn" id="logoutBtn">
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </div>
        </header>

        <div class="main-container">
            <aside class="sidebar">
                <nav>
                    <ul class="sidebar-menu">
                        <li><a href="#" class="menu-item active" data-tab="dashboard-tab"><i class="fas fa-home"></i> <span class="menu-text">Inicio</span></a></li>
                        <li><a href="#" class="menu-item" data-tab="patients-tab"><i class="fas fa-stethoscope"></i> <span class="menu-text">Pacientes</span></a></li>
                        <li><a href="#" class="menu-item" data-tab="appointments-tab"><i class="fas fa-calendar-check"></i> <span class="menu-text">Citas</span></a></li>
                        <li><a href="#" class="menu-item" data-tab="doctors-tab"><i class="fas fa-user-md"></i> <span class="menu-text">Médicos</span></a></li>
                        <li><a href="#" class="menu-item" data-tab="medicines-tab"><i class="fas fa-pills"></i> <span class="menu-text">Medicamentos</span></a></li>
                        <li><a href="#" class="menu-item" data-tab="reports-tab"><i class="fas fa-chart-bar"></i> <span class="menu-text">Reportes</span></a></li>
                        <li><a href="#" class="menu-item" data-tab="components-tab"><i class="fas fa-puzzle-piece"></i> <span class="menu-text">Componentes</span></a></li>
                        <li><a href="#" class="menu-item" data-tab="notifications-tab"><i class="fas fa-envelope"></i> <span class="menu-text">Notificaciones</span></a></li>
                        <li><a href="#" class="menu-item" data-tab="settings-tab"><i class="fas fa-cog"></i> <span class="menu-text">Configuración</span></a></li>
                    </ul>
                </nav>
            </aside>

            <main class="content">
                <!-- Dashboard Tab -->
                <div id="dashboard-tab" class="tab-content active">
                    <h1 class="page-title"><i class="fas fa-home"></i> Panel Principal</h1>

                    <div class="component-section">
                        <h2 class="section-title"><i class="fas fa-chart-line"></i> Resumen del Sistema</h2>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem;">
                            <div style="background: linear-gradient(to right, #4fc3f7, #03a9f4); color: white; padding: 1.5rem; border-radius: var(--border-radius);">
                                <h3>Pacientes Registrados</h3>
                                <p style="font-size: 2rem; font-weight: bold;">1,248</p>
                                <p><i class="fas fa-arrow-up"></i> 5% desde el mes pasado</p>
                            </div>
                            <div style="background: linear-gradient(to right, #66bb6a, #4caf50); color: white; padding: 1.5rem; border-radius: var(--border-radius);">
                                <h3>Citas Hoy</h3>
                                <p style="font-size: 2rem; font-weight: bold;">24</p>
                                <p><i class="fas fa-user-md"></i> 8 médicos activos</p>
                            </div>
                            <div style="background: linear-gradient(to right, #ffa726, #ff9800); color: white; padding: 1.5rem; border-radius: var(--border-radius);">
                                <h3>Ingresos Mensuales</h3>
                                <p style="font-size: 2rem; font-weight: bold;">$42,380</p>
                                <p><i class="fas fa-arrow-up"></i> 12% desde el mes pasado</p>
                            </div>
                        </div>
                    </div>

                    <div class="component-section">
                        <h2 class="section-title"><i class="fas fa-calendar-alt"></i> Próximas Citas</h2>
                        <div class="table-container">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Paciente</th>
                                        <th>Hora</th>
                                        <th>Médico</th>
                                        <th>Motivo</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Roberto Sánchez</td>
                                        <td>10:30 AM</td>
                                        <td>Dr. Juan Pérez</td>
                                        <td>Consulta general</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary"><i class="fas fa-check"></i></button>
                                            <button class="btn btn-sm btn-secondary"><i class="fas fa-pencil-alt"></i></button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>María González</td>
                                        <td>11:15 AM</td>
                                        <td>Dra. Ana Martínez</td>
                                        <td>Control prenatal</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary"><i class="fas fa-check"></i></button>
                                            <button class="btn btn-sm btn-secondary"><i class="fas fa-pencil-alt"></i></button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Jorge Rodríguez</td>
                                        <td>12:00 PM</td>
                                        <td>Dr. Carlos López</td>
                                        <td>Resultados de análisis</td>
                                        <td>
                                            <button class="btn btn-sm btn-primary"><i class="fas fa-check"></i></button>
                                            <button class="btn btn-sm btn-secondary"><i class="fas fa-pencil-alt"></i></button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Componentes Tab -->
                <div id="components-tab" class="tab-content">
                    <h1 class="page-title"><i class="fas fa-puzzle-piece"></i> Componentes del Sistema</h1>

                    <div class="tabs">
                        <div class="tab active" data-content="buttons-tab">Botones</div>
                        <div class="tab" data-content="forms-tab">Formularios</div>
                        <div class="tab" data-content="tables-tab">Tablas</div>
                    </div>

                    <div id="buttons-tab" class="tab-content active">
                        <section class="component-section">
                            <h2 class="section-title"><i class="fas fa-hand-pointer"></i> Botones</h2>
                            <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 15px;">
                                <button class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Pequeño</button>
                                <button class="btn btn-primary">Mediano</button>
                                <button class="btn btn-primary btn-lg">Grande</button>
                            </div>
                            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                                <button class="btn btn-primary">Primario</button>
                                <button class="btn btn-secondary">Secundario</button>
                                <button class="btn btn-success">Éxito</button>
                                <button class="btn btn-error">Error</button>
                                <button class="btn btn-warning">Advertencia</button>
                            </div>
                        </section>
                    </div>

                    <div id="forms-tab" class="tab-content">
                        <section class="component-section">
                            <h2 class="section-title"><i class="fas fa-list-alt"></i> Combobox</h2>
                            <div class="form-group">
                                <label class="form-label">Seleccione una especialidad:</label>
                                <select class="form-control">
                                    <option value="">-- Seleccione --</option>
                                    <option value="1">Cardiología</option>
                                    <option value="2">Pediatría</option>
                                    <option value="3">Dermatología</option>
                                    <option value="4">Oftalmología</option>
                                    <option value="5">Ginecología</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Seleccione un médico:</label>
                                <select class="form-control">
                                    <option value="">-- Seleccione --</option>
                                    <option value="1">Dr. Juan Pérez</option>
                                    <option value="2">Dra. María García</option>
                                    <option value="3">Dr. Carlos López</option>
                                    <option value="4">Dra. Ana Martínez</option>
                                </select>
                            </div>
                        </section>
                    </div>

                    <div id="tables-tab" class="tab-content">
                        <section class="component-section">
                            <h2 class="section-title"><i class="fas fa-table"></i> Tablas</h2>
                            <div class="table-container">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Paciente</th>
                                            <th>Edad</th>
                                            <th>Médico</th>
                                            <th>Fecha Cita</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>1001</td>
                                            <td>Roberto Sánchez</td>
                                            <td>45</td>
                                            <td>Dr. Juan Pérez</td>
                                            <td>15/05/2023</td>
                                            <td><span style="color: var(--success);">Completada</span></td>
                                        </tr>
                                        <tr>
                                            <td>1002</td>
                                            <td>María González</td>
                                            <td>32</td>
                                            <td>Dra. Ana Martínez</td>
                                            <td>16/05/2023</td>
                                            <td><span style="color: var(--warning);">Pendiente</span></td>
                                        </tr>
                                        <tr>
                                            <td>1003</td>
                                            <td>Jorge Rodríguez</td>
                                            <td>61</td>
                                            <td>Dr. Carlos López</td>
                                            <td>17/05/2023</td>
                                            <td><span style="color: var(--warning);">Pendiente</span></td>
                                        </tr>
                                        <tr>
                                            <td>1004</td>
                                            <td>Laura Mendoza</td>
                                            <td>28</td>
                                            <td>Dra. María García</td>
                                            <td>18/05/2023</td>
                                            <td><span style="color: var(--error);">Cancelada</span></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    </div>
                </div>

                <!-- Notificaciones Tab -->
                <div id="notifications-tab" class="tab-content">
                    <h1 class="page-title"><i class="fas fa-envelope"></i> Notificaciones por Correo</h1>

                    <section class="component-section">
                        <h2 class="section-title"><i class="fas fa-paper-plane"></i> Enviar Notificación</h2>

                        <form id="notificationForm">
                            <div class="form-group">
                                <label class="form-label">Destinatario:</label>
                                <select class="form-control" required>
                                    <option value="">-- Seleccione un destinatario --</option>
                                    <option value="patient">Paciente</option>
                                    <option value="doctor">Médico</option>
                                    <option value="staff">Personal</option>
                                    <option value="all">Todos los usuarios</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Asunto:</label>
                                <input type="text" class="form-control" placeholder="Asunto del mensaje" required>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Mensaje:</label>
                                <textarea class="form-control" rows="5" placeholder="Escribe tu mensaje aquí..." required></textarea>
                            </div>

                            <div class="form-group">
                                <label class="form-label">Prioridad:</label>
                                <select class="form-control">
                                    <option value="low">Baja</option>
                                    <option value="normal" selected>Normal</option>
                                    <option value="high">Alta</option>
                                </select>
                            </div>

                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane"></i> Enviar Notificación
                            </button>
                        </form>
                    </section>

                    <section class="component-section">
                        <h2 class="section-title"><i class="fas fa-history"></i> Historial de Notificaciones</h2>
                        <div class="table-container">
                            <table>
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Destinatario</th>
                                        <th>Asunto</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>12/05/2023 10:30</td>
                                        <td>Dr. Juan Pérez</td>
                                        <td>Recordatorio de reunión médica</td>
                                        <td><span style="color: var(--success);">Enviado</span></td>
                                    </tr>
                                    <tr>
                                        <td>11/05/2023 15:45</td>
                                        <td>Pacientes con cita pendiente</td>
                                        <td>Confirmación de cita médica</td>
                                        <td><span style="color: var(--success);">Enviado</span></td>
                                    </tr>
                                    <tr>
                                        <td>10/05/2023 09:15</td>
                                        <td>Personal administrativo</td>
                                        <td>Nuevos protocolos de atención</td>
                                        <td><span style="color: var(--success);">Enviado</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>
                </div>

                <!-- Otras pestañas (simplificadas) -->
                <div id="patients-tab" class="tab-content">
                    <h1 class="page-title"><i class="fas fa-stethoscope"></i> Gestión de Pacientes</h1>
                    <div class="component-section text-center">
                        <p>Contenido de gestión de pacientes</p>
                    </div>
                </div>

                <div id="appointments-tab" class="tab-content">
                    <h1 class="page-title"><i class="fas fa-calendar-check"></i> Gestión de Citas</h1>
                    <div class="component-section text-center">
                        <p>Contenido de gestión de citas</p>
                    </div>
                </div>

                <div id="doctors-tab" class="tab-content">
                    <h1 class="page-title"><i class="fas fa-user-md"></i> Gestión de Médicos</h1>
                    <div class="component-section text-center">
                        <p>Contenido de gestión de médicos</p>
                    </div>
                </div>

                <div id="medicines-tab" class="tab-content">
                    <h1 class="page-title"><i class="fas fa-pills"></i> Gestión de Medicamentos</h1>
                    <div class="component-section text-center">
                        <p>Contenido de gestión de medicamentos</p>
                    </div>
                </div>

                <div id="reports-tab" class="tab-content">
                    <h1 class="page-title"><i class="fas fa-chart-bar"></i> Reportes y Estadísticas</h1>
                    <div class="component-section text-center">
                        <p>Contenido de reportes y estadísticas</p>
                    </div>
                </div>

                <div id="settings-tab" class="tab-content">
                    <h1 class="page-title"><i class="fas fa-cog"></i> Configuración del Sistema</h1>
                    <div class="component-section text-center">
                        <p>Contenido de configuración del sistema</p>
                    </div>
                </div>
            </main>
        </div>

        <footer>
            <div class="copyright">
                &copy; 2023 Centro Médico - Todos los derechos reservados
            </div>
            <div class="social-links">
                <a href="#" class="social-link"><i class="fab fa-facebook"></i></a>
                <a href="#" class="social-link"><i class="fab fa-twitter"></i></a>
                <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                <a href="#" class="social-link"><i class="fab fa-linkedin"></i></a>
            </div>
        </footer>
    </div>

    <!-- Contenedor de notificaciones -->
    <div class="notification-container" id="notificationContainer">
        <!-- Las notificaciones se insertarán aquí dinámicamente -->
    </div>
    <script src="~/Scripts/Home/LogiAzul.js"></script>
</body>
</html>