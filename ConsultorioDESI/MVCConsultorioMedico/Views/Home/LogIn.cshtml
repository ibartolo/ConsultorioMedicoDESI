
@{
    ViewBag.Title = "Autenticación";
    Layout = "~/Views/Shared/_Autentication.cshtml";
}

<div class="auth-card">
    <div class="auth-header">
        <div class="auth-logo">
            <i class="fas fa-hospital"></i>
            <span>Centro Médico</span>
        </div>
        <h1 class="auth-title">Iniciar Sesión</h1>
        <p class="auth-subtitle">Ingresa a tu cuenta para continuar</p>
    </div>

    
        <div class="form-group">
            <label class="form-label">Usuario o Correo Electrónico</label>
            <div class="input-with-icon">
                <i class="fas fa-user input-icon"></i>
                <input type="text" id="txtUserName" class="form-control" placeholder="Ingresa tu usuario o email" required>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Contraseña</label>
            <div class="input-with-icon">
                <i class="fas fa-lock input-icon"></i>
                <input id="txtPassword" type="password" class="form-control" placeholder="Ingresa tu contraseña" required>
            </div>
        </div>

        <div class="form-options">
            <label class="remember-me">
                <input type="checkbox">
                <span>Recordarme</span>
            </label>
            <a href="#" class="forgot-password">¿Olvidaste tu contraseña?</a>
        </div>

        <button class="btn btn-primary" onclick="LoginUser()">
            <i class="fas fa-sign-in-alt"></i>
            Iniciar Sesión
        </button>

        <div class="divider">
            <span>o continuar con</span>
        </div>

        <div class="social-login">
            <button type="button" class="btn btn-social">
                <i class="fab fa-google"></i>
                Google
            </button>
            <button type="button" class="btn btn-social">
                <i class="fab fa-microsoft"></i>
                Microsoft
            </button>
        </div>
    

    <div class="auth-footer">
        ¿No tienes una cuenta? <a href="#">Solicitar acceso</a>
    </div>
</div>
<script src="~/Scripts/Home/LogIn.js"></script>