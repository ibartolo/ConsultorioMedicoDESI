@model EntidadesConsultorioMedico.ObjUsuario

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_TemplateAzul.cshtml";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>

<h2>Usuarios</h2>

@using (Html.BeginForm("SaveOrUpdateUsuario", "Usuario", FormMethod.Post, new { @id = "frmUsuario", @name = "frmUsuario" }))
{
    @Html.HiddenFor(x => x.Id)
    @Html.HiddenFor(x => x.CreatedDt)
    @Html.HiddenFor(x => x.CreatedBy)
    @Html.HiddenFor(x => x.UpdatedBy)
    @Html.HiddenFor(x => x.UpdatedDt)

    <div class="row">
        <div class="col-md-12">
            <div class="row form-group">
                <div class="col-md-4">
                    <label>Nombre de usuario</label>
                    @Html.TextBoxFor(m => m.UserName, new { @class = "form-control" })
                </div>
                <div class="col-md-4">
                    <label>Contraseña</label>
                    @Html.TextBoxFor(m => m.Pass, new { @class = "form-control" })
                </div>
                <div class="col-md-4">
                    <label>Email</label>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                </div>
            </div>

            <div class="row form-group">
                <div class="col-md-6">
                    <label>Nombre</label>
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                </div>
                <div class="col-md-6">
                    <label>Apellido</label>
                    @Html.TextBoxFor(m => m.Apellido, new { @class = "form-control" })
                </div>

            </div>

            <div class="row form-group">
                <div class="col-md-12">
                    <button class="btn btn-success notika-btn-success waves-effect" id="btnGuardar">Guardar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <table id="tblUsuario" class="table"></table>
        </div>
    </div>
}

<link href="~/Attachment/JqueeyDatatable/jquery.dataTables.min.css" rel="stylesheet" />
<script src="~/Attachment/JqueeyDatatable/jquery.dataTables.min.js"></script>

<script src="~/Scripts/Usuario/Index.js"></script>
